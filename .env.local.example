# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Supabase (get from supabase.com > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — Edge Functions only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Football-Data.org (free tier, 10 req/min)
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Claude API — Edge Functions only (vision analysis, push copy generation)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Stripe (Phase 2 only — leave blank until Week 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
